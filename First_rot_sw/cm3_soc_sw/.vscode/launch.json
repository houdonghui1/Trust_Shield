    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${workspaceFolder}/project/firmware_sdk/bootloader/output/bootloader.elf",
            "servertype": "jlink",  // 或 "openocd"（ST-Link）
            "device": "Cortex-M3",  // 根据芯片型号修改 ‌:ml-citation{ref="7" data="citationList"}
            "interface": "swd",
            "runToEntryPoint": "main",  // 直接运行到main函数
            "gdbPath": "/usr/bin/gdb-multiarch",
            "armToolchainPath": "/usr/bin"
        }

    ]
}